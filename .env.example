# ---------------------------------------------------------------------------
# Arvo configuration. Copy to .env and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Host ports (docker compose)
WEB_PORT=3300
API_PORT=3301
MCP_PORT=3302
SITE_PORT=3400
POSTGRES_PORT=5433

# Database
POSTGRES_USER=arvo
POSTGRES_PASSWORD=arvo
POSTGRES_DB=arvo
DATABASE_URL=postgres://arvo:arvo@localhost:5433/arvo
# Used by `pnpm test:e2e`; the database is created if missing.
TEST_DATABASE_URL=postgres://arvo:arvo@localhost:5433/arvo_test

# Auth — generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Encrypts authenticator (TOTP) secrets at rest. 32 bytes: openssl rand -base64 32
# Strongly recommended; when empty a key is derived from JWT_SECRET and the API logs a warning.
# Changing it disables existing authenticator setups.
TWO_FACTOR_ENCRYPTION_KEY=
# Block sign-in until the email address is confirmed.
REQUIRE_EMAIL_VERIFICATION=false

# Email: smtp | console | memory. Default is console (emails, links and codes are printed in
# the API log). For a local inbox: `docker compose --profile mail up -d mailpit`, set
# MAIL_DRIVER=smtp, MAIL_HOST=localhost, MAIL_PORT=1025 and open http://localhost:8025.
MAIL_DRIVER=console
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Arvo <no-reply@arvo.local>
# Email a notice after every sign-in.
MAIL_LOGIN_ALERTS=false

# Web
CORS_ORIGIN=http://localhost:3300
NEXT_PUBLIC_API_URL=http://localhost:3301
# Public URLs. Set these to your real HTTPS addresses when Arvo is reachable from the internet;
# ChatGPT and claude.ai connectors need a public HTTPS MCP URL.
PUBLIC_API_URL=http://localhost:3301
PUBLIC_WEB_URL=http://localhost:3300
# Canonical MCP server URI; OAuth tokens are bound to it.
MCP_RESOURCE_URL=http://localhost:3302/mcp

# MCP endpoint shown in Settings → AI assistants
NEXT_PUBLIC_MCP_URL=http://localhost:3302/mcp
# Landing site → app link. Leave empty to show the closed-beta "request access" modal instead.
NEXT_PUBLIC_APP_URL=http://localhost:3300

# AI provider: none | openai | anthropic | gemini | ollama
# Cloud providers receive financial data you ask about. Ollama keeps it local.
AI_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Uploaded statements
STORAGE_PATH=./storage
