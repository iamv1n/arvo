{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": ["DATABASE_URL", "TEST_DATABASE_URL", "JWT_SECRET", "PUBLIC_API_URL", "PUBLIC_WEB_URL", "MCP_RESOURCE_URL", "CORS_ORIGIN", "TWO_FACTOR_ENCRYPTION_KEY", "REQUIRE_EMAIL_VERIFICATION", "MAIL_*", "REMINDERS_ENABLED", "AI_PROVIDER", "AI_MODEL", "ADVICE_LEVEL", "AI_MAX_TOOL_ROUNDS", "WEEKLY_BRIEFING_ENABLED", "OPENAI_API_KEY", "ANTHROPIC_API_KEY", "GEMINI_API_KEY", "OLLAMA_BASE_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
